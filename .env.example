# 값은 비워 둔다. 실제 값은 .env.local 에 넣고 커밋하지 않는다 (ADR-0003).
# 여기에는 브라우저에 나가도 되는 공개 값의 이름만 둔다.
# service role 키, Resend 키, VAPID 비밀 키, OAuth client secret 은 이 파일에도 .env.local 에도 두지 않는다
# (GitHub Actions secrets, Supabase Edge Function secrets 에만 둔다).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
